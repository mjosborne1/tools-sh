#!/bin/sh

#
# valTests 
# 
# This script Validates json resources in a folder
# Usage: ./valTests
# Example: ./valTests ~/Development/hl7au/mjo-au-fhir-test-data ~/data/valTests AU 


jar=$HOME/jar/validator_cli.jar
region="AU"
if [[ "$#" == "2" || "$#" == "3" ]]; then
    indir="$1"
    outdir="$2"
    if [[ "$#" == "3" ]]; then
        region="$3"
    fi
else
    indir="$HOME/data/valTests/json"
    outdir="$HOME/data/valTests/results"
fi 

if [[ "$region" != "AU" && "$region" != "US" ]]; then
    echo "$0: Region must be AU or US."
    exit 1
fi

if [[ "$region" == "AU" ]]; then
    tx_url="https://tx.hl7.org.au/fhir"
    locale="en-AU"
    sct="au"
else
    tx_url="https://tx.fhir.org/r4"
    locale="en-US"
    sct="us"
fi

# Check if the input directory exists
if [ ! -d "$indir" ]; then
    echo "$0: Directory $indir does not exist."
    exit 1
fi

# Check if the output directory exists
if [ ! -d "$outdir" ]; then
    echo "$0: Creating $outdir"
    mkdir -p $outdir
fi

# run validator on the folder (indir)
json_count=$(ls -1 $indir/*.json 2>/dev/null | wc -l | tr -d ' ')
start_time=$(date +%s)
java -jar $jar -tx $tx_url -version 4.0.1 -locale $locale -sct $sct  -txLog $outdir/txlog.txt -output $outdir/results.html $indir/*.json
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Validation of ${json_count} file(s) completed in ${elapsed}s"
